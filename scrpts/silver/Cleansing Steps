select 
cst_id,
cst_key,
--Trimming Names
trim(cst_firstname) as cst_firstname,
trim(cst_lastname) as cst_lastname,
--Data standardization and Default value
case 
     when upper(trim(cst_marital_status)) = 'M' then 'Married'
     when upper(trim(cst_marital_status)) = 'F' then 'Single'
     else 'Not Applicable'
end as cst_marital_status,
--Data standardization and Default value
case 
     when upper(trim(cst_gndr)) = 'M' then 'Male'
     when upper(trim(cst_gndr)) = 'F' then 'Female'
     else 'Not Applicable'
end as cst_marital_status,
cst_create_date
from 
--Identifying NULL and Duplicates in primary key cst_id
(select *,
ROW_NUMBER() over (partition by cst_id order by cst_create_date desc) as FlagPick
from bronze.crm_cust_info
where cst_id is not null)t
where FlagPick = 1
